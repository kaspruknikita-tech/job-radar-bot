# ============================================================
# ОБЯЗАТЕЛЬНОЕ — без этого бот не стартует
# ============================================================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Куда слать карточки вакансий: личный чат с ботом или приватная группа.
# Как узнать id: напишите боту @userinfobot (личный чат) или добавьте бота в группу.
TELEGRAM_MODERATION_CHAT=-100000000000
# Необязательно: отдельные чаты для РФ и зарубежных вакансий (иначе всё в MODERATION_CHAT)
TELEGRAM_MODERATION_CHAT_RU=
TELEGRAM_MODERATION_CHAT_GLOBAL=

# PostgreSQL. Локально: brew install postgresql@16 && createdb jobs
DATABASE_URL=postgresql://user:password@localhost:5432/jobs

# Google-таблица для решений по кнопкам («Откликаюсь / Не подходит / Позже»).
# id — часть ссылки между /d/ и /edit. Ключ сервис-аккаунта положить в google_credentials.json
# в корне проекта (или целиком JSON в GOOGLE_CREDENTIALS_JSON) и расшарить таблицу на его email.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=

# ============================================================
# ПРОФИЛЬ — что искать и как оценивать
# ============================================================

# Папка профиля: profile.py (запросы, фильтры, словари, гео) и role-profile.md (для модели).
# По умолчанию — profile/ в корне проекта.
PROFILE_DIR=
# Необязательно: карьерные данные для ATS-совпадения (формат — scoring/career_os.py).
# Нет папки — ATS-часть скоринга выключена.
CAREER_DATA_DIR=

# ============================================================
# ИСТОЧНИКИ
# ============================================================

# hh.ru: анонимно отдаёт 403, нужен OAuth приложения. Регистрация: https://dev.hh.ru/
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_USER_AGENT=JobRadar/1.0 (your@email.com)

# Telegram-каналы с вакансиями, через запятую (без @).
# Публичные каналы читаются через веб-превью t.me/s/ без аккаунта.
TG_SOURCE_CHANNELS=pmjobs,jobsforpm,igaming_work,gamedevjob,relocate_jobs
TG_PREVIEW_MAX_PAGES=3
TG_DAYS_BACK=7
# Необязательно: Telethon для закрытых каналов. https://my.telegram.org → API development tools
# Строка сессии: python scripts/gen_tg_session.py
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# LinkedIn через python-jobspy. С домашнего IP можно без прокси, на сервере — обязательно.
JOBSPY_PROXIES=
JOBSPY_RESULTS_WANTED=20
JOBSPY_HOURS_OLD=0

# Hirify: без подписки видны вакансии, но не названия компаний
HIRIFY_EMAIL=
HIRIFY_PASSWORD=

# Лимиты источников за цикл
GETMATCH_MAX_OFFERS=400
HABR_MAX_PAGES=2
RABOTARU_MAX_VACANCIES=60
JOBICY_COUNT=50
REMOTEROCKETSHIP_MAX_PAGES=2
CAREER_SITES_PER_CYCLE=25

# ============================================================
# ЛОКАЛЬНАЯ МОДЕЛЬ (необязательно) — смысловой фильтр «это про меня?»
# ============================================================
# Ollama + qwen3:8b: brew install ollama && ollama pull qwen3:8b
# Модель читает profile/role-profile.md. Выключено — работают только правила.
LLM_ROLE_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Ниже этой уверенности вердикт модели не отменяет решение правил
LLM_ROLE_MIN_CONFIDENCE=60
# Бонус к баллам, если модель подтвердила роль
LLM_ROLE_BONUS=25

# ============================================================
# ПЛАНИРОВЩИК И АЛЕРТЫ
# ============================================================
PARSE_INTERVAL_MINUTES=15
# Сколько карточек слать за интервал (лучшие по скору)
MODERATION_MAX_PER_CYCLE=20
# Только вакансии, опубликованные за последние N дней
MAX_VACANCY_AGE_DAYS=7
# Чат для алертов об ошибках (пусто — алерты выключены)
TELEGRAM_ALERT_CHAT=
TELEGRAM_ALERT_MENTION=
# Час (МСК) ежедневной сводки по источникам
DAILY_REPORT_HOUR=9
LOG_LEVEL=INFO
